  "keyFeatures": [
    "Remote access to wind and solar measurement data from anywhere",
    "Equipment configuration and management for NRG loggers and sensors",
    "Secure cloud storage with Auth0 authentication",
    "RESTful API for programmatic data access",
    "Support for LOGR Met Data Logger and ZX 300e Wind Lidar",
    "Data export in multiple formats (CSV, JSON)",
    "Real-time troubleshooting and diagnostic tools",
    "Unified ecosystem integrating NRG hardware and software"
  ],
  "publicApiSurface": [
    "GET /sites — list measurement sites",
    "GET /sites/{siteId}/data — retrieve time-series sensor data",
    "GET /sites/{siteId}/devices — list devices at a site",
    "GET /files — list available data files",
    "POST /files/convert — convert raw logger files",
    "GET /files/{fileId}/download — download a data file",
    "POST /auth/token — obtain API access token",
    "nrgpy.cloud_api — Python library for NRG Cloud API",
    "nrgpy.symphonie_export — read Symphonie exported text files"
  ]
